{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/assurance-policy.v1.json",
  "title": "HOL Guard managed assurance policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "hol-guard.assurance-policy.v1"},
    "name": {"type": "string", "minLength": 1},
    "block_at": {"$ref": "#/$defs/severity"},
    "review_at": {"$ref": "#/$defs/severity"},
    "warn_at": {"$ref": "#/$defs/severity"},
    "minimum_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "incomplete_coverage": {"$ref": "#/$defs/disposition"},
    "error_coverage": {"$ref": "#/$defs/disposition"},
    "minimum_assurance": {
      "enum": ["static", "provenance-verified", "sandbox-planned", "sandbox-observed"]
    },
    "require_provenance": {"type": "boolean"},
    "require_detonation": {"type": "boolean"},
    "require_rust_for_native": {"type": "boolean"},
    "deny_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_upload_hosts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "trusted_signers": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "maximum_evidence_age_seconds": {"type": "integer", "minimum": 1},
    "maximum_clock_skew_seconds": {"type": "integer", "minimum": 0},
    "maximum_findings": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "disposition": {"enum": ["allow", "warn", "review", "block", "error"]}
  }
}
